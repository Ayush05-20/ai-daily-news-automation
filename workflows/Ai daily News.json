      "id": "81f10f0f-a924-419e-bfe5-61dc7d24e0bc",
      "name": "Top 15"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst date = $now.toFormat('d LLLL yyyy').toUpperCase();\n\n// escape text for safe use inside HTML\nconst esc = s => String(s)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\n// ---- WhatsApp / plain text version ----\nconst header = `🤖 *AI NEWS — ${date}*\\n`;\nconst blocks = items.map((a, i) =>\n  `\\n*${i + 1}. ${a.headline}*\\n${a.summary}\\n_Why it matters:_ ${a.why_it_matters}\\n🔗 ${a.source}: ${a.url}\\n`\n);\n\n// keep the message under a safe length by dropping the least important stories\nlet text = header;\nlet used = 0;\nfor (const block of blocks) {\n  if ((text + block).length > 3500) break;\n  text += block;\n  used++;\n}\n\n// ---- Email (HTML) version ----\nconst htmlStories = items.map((a, i) => `\n  <div style=\"margin-bottom:20px\">\n    <h3 style=\"margin:0 0 4px\">${i + 1}. ${esc(a.headline)}</h3>\n    <div style=\"color:#666;font-size:12px\">${esc(a.category)} · ${esc(a.source)}</div>\n    <p style=\"margin:6px 0\">${esc(a.summary)}</p>\n    <p style=\"margin:6px 0\"><em>Why it matters:</em> ${esc(a.why_it_matters)}</p>\n    <a href=\"${esc(a.url)}\">Read the article</a>\n  </div>`).join('');\n\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:640px\">\n  <h2>🤖 AI News — ${date}</h2>${htmlStories}\n</div>`;\n\nreturn [{ json: {\n  subject: `AI News Digest — ${date}`,\n  text,\n  html,\n  storiesInWhatsApp: used,\n  totalStories: items.length,\n} }];"
      },
