      "id": "723adbec-0fec-41c1-ad98-9d8e533ecac3",
      "name": "Message a model",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "vJe6SZZt9yLsCBwu",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. Get the AI's text answer (join all parts that contain text)\nconst raw = $input.first().json.content.parts\n  .map(p => p.text || '')\n  .join('');\n\n// 2. Remove markdown fences if the model added any, then parse\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('AI returned invalid JSON: ' + cleaned.slice(0, 200));\n}\n\n// 3. Look up the real article data by ID\nconst originals = $('Top 15').all();\nconst seen = new Set();\nconst results = [];\n\nfor (const a of data.articles || []) {\n  const original = originals[a.id - 1];\n  if (!original || seen.has(a.id)) continue; // unknown or repeated ID: skip\n  seen.add(a.id);\n\n  results.push({\n    json: {\n      headline: a.headline,\n      summary: a.summary,\n      why_it_matters: a.why_it_matters,\n      category: a.category,\n      importance: a.importance,\n      url: original.json.url,\n      source: original.json.source,\n      published: original.json.published,\n    },\n  });\n}\n\n// 4. Most important first\nresults.sort((x, y) => y.json.importance - x.json.importance);\n\nif (results.length === 0) {\n  throw new Error('No valid articles after parsing');\n}\n\nreturn results;;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2304,
        240
      ],
      "id": "6f032638-e9a5-44f1-838c-61bfd578f0a1",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Number each article and turn the list into text\nconst articlesText = items\n  .map((item, i) => `[${i + 1}] ${item.json.title} (${item.json.source})\\n${item.json.snippet}`)\n  .join('\\n\\n');\n\nconst prompt = `You are an editor writing a daily AI news digest.\nBelow are ${items.length} articles. Each starts with an ID in square brackets.\n\nRULES:\n- Use ONLY the information in the articles. Do not add facts, numbers, quotes or links that are not in the text.\n- If an article gives too little information, write a shorter summary instead of guessing.\n- Skip duplicate stories (keep the best version) and low-value items such as gossip or pure opinion.\n- Select the 8 most important stories.\n\nFor each selected story return:\n- id: the article's ID number, exactly as given\n- headline: at most 12 words\n- summary: 1 to 2 plain sentences\n- why_it_matters: 1 sentence\n- category: one of LLMs, Agents, Robotics, Startups & Funding, Research, Policy & Safety, Products, Other\n- importance: a number from 1 (minor) to 5 (major)\n\nOUTPUT FORMAT: return ONLY valid JSON, with no markdown and no extra text, in exactly this shape:\n{\"articles\":[{\"id\":1,\"headline\":\"...\",\"summary\":\"...\",\"why_it_matters\":\"...\",\"category\":\"LLMs\",\"importance\":4}]}\n\nARTICLES:\n${articlesText}`;\n\nreturn [{ json: { prompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
        240
      ],
